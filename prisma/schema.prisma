// Schema do Lume. Os nomes das tabelas e colunas seguem snake_case via @map /
// @@map — o TypeScript fica em camelCase sem que o SQL precise mudar.
//
// Alterou algo aqui? Gere a migration com:
//   npx prisma migrate dev --name <descricao>

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  // citext: "Pedro" e "pedro" são o mesmo usuário, garantido pelo banco e não
  // por uma checagem na aplicação (que teria corrida entre ler e inserir).
  username     String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  habits     Habit[]
  habitMarks HabitMark[]
  days       Day[]
  tasks      Task[]
  weekTasks  WeekTask[]
  weekMarks  WeekMark[]

  @@map("users")
}

/// Mapa do Mês: os hábitos de cada mês. Quantos existem é escolha do usuário —
/// cada linha aqui é um hábito, e `slot` é o identificador/ordem dentro do mês
/// (cresce a cada novo hábito; apagar um deixa um buraco, o que não é problema).
model Habit {
  userId   Int    @map("user_id")
  monthKey String @map("month_key") // 'YYYY-MM'
  slot     Int
  name     String @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, monthKey, slot])
  @@map("habits")
}

/// Mapa do Mês: marcações do anel radial
model HabitMark {
  userId   Int    @map("user_id")
  monthKey String @map("month_key")
  slot     Int
  day      Int // 1..31

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, monthKey, slot, day])
  @@map("habit_marks")
}

/// Planner Diário: cabeçalho do dia
model Day {
  userId Int    @map("user_id")
  date   String // 'YYYY-MM-DD'
  notes  String @default("")
  rating Int? // 1..5 (carinhas)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("days")
}

/// Planner Diário: tarefas ('normal' | 'inegociavel')
model Task {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  date     String
  kind     String
  text     String
  done     Int    @default(0)
  position Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date, kind, position], map: "tasks_by_day")
  @@map("tasks")
}

/// Planejamento Semanal: uma tarefa de um dia da semana. Fixa, ela é a mesma
/// em todas as semanas e o que muda de semana para semana é só a marcação
/// (WeekMark); solta, ela vive apenas na semana em que foi criada.
model WeekTask {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  weekday  Int    @map("weekday") // 0..6, 0 = domingo (índice de Date#getDay)
  text     String
  position Int    @default(0)
  /// Segunda-feira em que a tarefa entrou na rotina. Sem isso o gráfico teria
  /// de dividir as semanas antigas pelo número de tarefas de hoje, e cada
  /// tarefa nova faria o passado inteiro parecer pior do que foi.
  createdWeek String @map("created_week")
  /// Vazio = fixa: aparece em toda semana a partir de `createdWeek`. Preenchido
  /// = solta, e aquela é a única semana em que ela aparece. Uma coluna guarda as
  /// duas coisas — se é fixa e, quando não é, de qual semana ela é.
  onlyWeek String? @map("only_week")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  marks WeekMark[]

  @@index([userId, weekday, position], map: "week_tasks_by_weekday")
  @@map("week_tasks")
}

/// Planejamento Semanal: a tarefa foi concluída naquela semana.
model WeekMark {
  taskId    Int    @map("task_id")
  weekStart String @map("week_start") // 'YYYY-MM-DD' da segunda-feira
  userId    Int    @map("user_id")

  task WeekTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, weekStart])
  @@index([userId, weekStart], map: "week_marks_by_week")
  @@map("week_marks")
}
