# Copie para .env.local e preencha. Na Vercel, configure as duas em
# Settings → Environment Variables.

# String de conexão do Postgres. Use sempre a versão *pooled*:
#   Neon     → host com "-pooler" (a integração da Vercel já cria assim)
#   Supabase → Connection Pooling, porta 6543
#
# É o `sslmode` daqui que liga ou desliga o TLS — o código não tenta adivinhar.
# Serviço na nuvem pede `sslmode=require`; um Postgres local sem TLS não deve
# levar `sslmode` nenhum, senão a conexão falha com "server does not support SSL".
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Exemplo de Postgres local:
# DATABASE_URL=postgres://postgres@localhost:5432/lume

# Assina os cookies de sessão. Obrigatória em produção (mínimo 32 caracteres).
# Gere uma com: openssl rand -base64 32
SESSION_SECRET=
#Teste
# Opcional, e só em desenvolvimento: banco temporário que o `prisma migrate dev`
# usa para gerar migrations. Deixe em branco se o seu Postgres permite que o
# Prisma crie esse banco sozinho — é o caso da Neon e do Supabase.
# SHADOW_DATABASE_URL=
